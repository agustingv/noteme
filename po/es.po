# UI strings — main window
msgid "Preferences"
msgstr "Preferencias"

msgid "About NoteMe"
msgstr "Acerca de NoteMe"

msgid "Main Menu"
msgstr "Menú principal"

msgid "New Note"
msgstr "Nueva nota"

msgid "Delete Note"
msgstr "Eliminar nota"

msgid "Search notes…"
msgstr "Buscar notas…"

msgid "No Note Selected"
msgstr "Ninguna nota seleccionada"

msgid "Select a note from the sidebar or create a new one."
msgstr "Selecciona una nota de la barra lateral o crea una nueva."

msgid "Note title…"
msgstr "Título de la nota…"

msgid "Note color"
msgstr "Color de la nota"

# Rich editor toolbar
msgid "Bold (Ctrl+B)"
msgstr "Negrita (Ctrl+B)"

msgid "Italic (Ctrl+I)"
msgstr "Cursiva (Ctrl+I)"

msgid "Underline (Ctrl+U)"
msgstr "Subrayado (Ctrl+U)"

msgid "Inline Code (Ctrl+`)"
msgstr "Código en línea (Ctrl+`)"

msgid "Bullet List (Ctrl+Shift+L)"
msgstr "Lista con viñetas (Ctrl+Mayús+L)"

msgid "Markdown Preview (Ctrl+Shift+P)"
msgstr "Vista previa Markdown (Ctrl+Mayús+P)"

# Delete note dialog
msgid "Delete Note?"
msgstr "¿Eliminar nota?"

msgid "%s will be permanently deleted."
msgstr "%s se eliminará de forma permanente."

msgid "Cancel"
msgstr "Cancelar"

msgid "Delete"
msgstr "Eliminar"

# Color picker labels
msgid "Default"
msgstr "Predeterminado"

msgid "Red"
msgstr "Rojo"

msgid "Yellow"
msgstr "Amarillo"

msgid "Lemon"
msgstr "Limón"

msgid "Sage"
msgstr "Salvia"

msgid "Mint"
msgstr "Menta"

msgid "Fog"
msgstr "Niebla"

msgid "Blue"
msgstr "Azul"

msgid "Purple"
msgstr "Morado"

msgid "Pink"
msgstr "Rosa"

# Preferences dialog
msgid "Editor"
msgstr "Editor"

msgid "Font"
msgstr "Fuente"

# About dialog
msgid "A simple note-taking app built with GTK4 and Vala."
msgstr "Una aplicación sencilla de notas construida con GTK4 y Vala."

# Note row — pin button
msgid "Pin note"
msgstr "Fijar nota"

msgid "Unpin note"
msgstr "Desfijar nota"

# Rich editor — export
msgid "Export to file"
msgstr "Exportar a archivo"

msgid "Export Note"
msgstr "Exportar nota"

msgid "Markdown files"
msgstr "Archivos Markdown"

msgid "Text files"
msgstr "Archivos de texto"

msgid "All files"
msgstr "Todos los archivos"

# Main menu
msgid "Extensions"
msgstr "Extensiones"

# Extensions dialog
msgid "Installed Extensions"
msgstr "Extensiones instaladas"

msgid "External plugins can be placed in %s as .so files. See README.md in https://github.com/agustingv/noteme how to create your own."
msgstr "Los complementos externos se pueden colocar en %s como archivos .so. Consulta el README.md en https://github.com/agustingv/noteme para saber cómo crear el tuyo."

# Word Count extension
msgid "Word Count"
msgstr "Contador de palabras"

msgid "Shows word and character count in the editor toolbar."
msgstr "Muestra el recuento de palabras y caracteres en la barra de herramientas."

msgid "%d words · %d chars"
msgstr "%d palabras · %d caracteres"

# Note Info extension
msgid "Note Info"
msgstr "Info de nota"

msgid "Shows detailed statistics about the current note."
msgstr "Muestra estadísticas detalladas sobre la nota actual."

msgid "Note Information"
msgstr "Información de la nota"

msgid "General"
msgstr "General"

msgid "Title"
msgstr "Título"

msgid "Created"
msgstr "Creada"

msgid "Color"
msgstr "Color"

msgid "Pinned"
msgstr "Fijada"

msgid "Untitled"
msgstr "Sin título"

msgid "None"
msgstr "Ninguno"

msgid "Yes"
msgstr "Sí"

msgid "No"
msgstr "No"

msgid "Statistics"
msgstr "Estadísticas"

msgid "Words"
msgstr "Palabras"

msgid "Characters"
msgstr "Caracteres"

msgid "Characters (no spaces)"
msgstr "Caracteres (sin espacios)"

msgid "Lines"
msgstr "Líneas"

msgid "Estimated reading time"
msgstr "Tiempo de lectura estimado"

msgid "< 1 min"
msgstr "< 1 min"

msgid "%d min"
msgstr "%d min"

# Crypt extension
msgid "Note Encryption"
msgstr "Cifrado de notas"

msgid "Encrypt and decrypt notes with a password (AES-256)"
msgstr "Cifra y descifra notas con una contraseña (AES-256)"

msgid "Encrypt / Decrypt Note"
msgstr "Cifrar / Descifrar nota"

msgid "Password"
msgstr "Contraseña"

msgid "Confirm password"
msgstr "Confirmar contraseña"

msgid "Encrypt Note"
msgstr "Cifrar nota"

msgid "Enter a password to encrypt this note. You will need the password to read it again."
msgstr "Introduce una contraseña para cifrar esta nota. La necesitarás para volver a leerla."

msgid "Encrypt"
msgstr "Cifrar"

msgid "Password cannot be empty"
msgstr "La contraseña no puede estar vacía"

msgid "Passwords do not match"
msgstr "Las contraseñas no coinciden"

msgid "Encryption failed"
msgstr "Error al cifrar"

msgid "Note encrypted"
msgstr "Nota cifrada"

msgid "Decrypt Note"
msgstr "Descifrar nota"

msgid "Enter the password to decrypt and view this note."
msgstr "Introduce la contraseña para descifrar y ver esta nota."

msgid "Decrypt"
msgstr "Descifrar"

msgid "Decryption failed — wrong password?"
msgstr "Error al descifrar: ¿contraseña incorrecta?"

msgid "Note decrypted"
msgstr "Nota descifrada"

# Image extension
msgid "Insert Image"
msgstr "Insertar imagen"

msgid "Adds a toolbar button for inserting images into notes."
msgstr "Agrega un botón en la barra de herramientas para insertar imágenes en las notas."

msgid "Select Image"
msgstr "Seleccionar imagen"

msgid "Images"
msgstr "Imágenes"

# Backup dialog
msgid "Backups"
msgstr "Copias de seguridad"

msgid "Create Backup"
msgstr "Crear copia de seguridad"

msgid "Destination Folder"
msgstr "Carpeta de destino"

msgid "Choose folder…"
msgstr "Elegir carpeta…"

msgid "Choose Backup Folder"
msgstr "Elegir carpeta de copia de seguridad"

msgid "Archives all notes and images into a tar.gz file"
msgstr "Archiva todas las notas e imágenes en un archivo tar.gz"

msgid "Restore Backup"
msgstr "Restaurar copia de seguridad"

msgid "Restoring a backup will overwrite current notes and images. The app must be restarted afterwards."
msgstr "Restaurar una copia de seguridad sobreescribirá las notas e imágenes actuales. La aplicación debe reiniciarse después."

msgid "Backup File"
msgstr "Archivo de copia de seguridad"

msgid "No file selected"
msgstr "Ningún archivo seleccionado"

msgid "Select backup file…"
msgstr "Seleccionar archivo de copia de seguridad…"

msgid "Restore"
msgstr "Restaurar"

msgid "Overwrites current data with the selected backup"
msgstr "Sobreescribe los datos actuales con la copia de seguridad seleccionada"

msgid "Select Backup File"
msgstr "Seleccionar archivo de copia de seguridad"

msgid "Backup archives"
msgstr "Archivos de copia de seguridad"

msgid "Restore Backup?"
msgstr "¿Restaurar copia de seguridad?"

msgid "This will overwrite all current notes and images. The application must be restarted to apply the changes."
msgstr "Esto sobreescribirá todas las notas e imágenes actuales. La aplicación debe reiniciarse para aplicar los cambios."

msgid "Backup Restored"
msgstr "Copia de seguridad restaurada"

msgid "The backup has been restored. Please restart the application to apply the changes."
msgstr "La copia de seguridad ha sido restaurada. Por favor, reinicia la aplicación para aplicar los cambios."

msgid "Close"
msgstr "Cerrar"

msgid "Restart Now"
msgstr "Reiniciar ahora"

msgid "Backup created"
msgstr "Copia de seguridad creada"

msgid "Backup failed"
msgstr "Error al crear la copia de seguridad"

msgid "Backup error"
msgstr "Error de copia de seguridad"

msgid "Restore failed"
msgstr "Error al restaurar"

msgid "Restore error"
msgstr "Error de restauración"

msgid "OK"
msgstr "Aceptar"
