# Crypt extension
#: src/extensions/crypt_extension.vala:6
msgid "Note Encryption"
msgstr "Cifrado de notas"

#: src/extensions/crypt_extension.vala:7
msgid "Encrypt and decrypt notes with a password (AES-256)"
msgstr "Cifra y descifra notas con una contraseña (AES-256)"

#: src/extensions/crypt_extension.vala:22
msgid "Encrypt / Decrypt Note"
msgstr "Cifrar / Descifrar nota"

#: src/extensions/crypt_extension.vala:104
#: src/extensions/crypt_extension.vala:187
msgid "Password"
msgstr "Contraseña"

#: src/extensions/crypt_extension.vala:109
msgid "Confirm password"
msgstr "Confirmar contraseña"

#: src/extensions/crypt_extension.vala:120
msgid "Encrypt Note"
msgstr "Cifrar nota"

#: src/extensions/crypt_extension.vala:121
msgid ""
"Enter a password to encrypt this note. You will need the password to read it "
"again."
msgstr ""
"Introduce una contraseña para cifrar esta nota. La necesitarás para volver a "
"leerla."

#: src/extensions/crypt_extension.vala:125
msgid "Encrypt"
msgstr "Cifrar"

#: src/extensions/crypt_extension.vala:137
#: src/extensions/crypt_extension.vala:210
msgid "Password cannot be empty"
msgstr "La contraseña no puede estar vacía"

#: src/extensions/crypt_extension.vala:142
msgid "Passwords do not match"
msgstr "Las contraseñas no coinciden"

#: src/extensions/crypt_extension.vala:158
msgid "Encryption failed"
msgstr "Error al cifrar"

#: src/extensions/crypt_extension.vala:171
msgid "Note encrypted"
msgstr "Nota cifrada"

#: src/extensions/crypt_extension.vala:194
msgid "Decrypt Note"
msgstr "Descifrar nota"

#: src/extensions/crypt_extension.vala:195
msgid "Enter the password to decrypt and view this note."
msgstr "Introduce la contraseña para descifrar y ver esta nota."

#: src/extensions/crypt_extension.vala:199
msgid "Decrypt"
msgstr "Descifrar"

#: src/extensions/crypt_extension.vala:229
msgid "Decryption failed — wrong password?"
msgstr "Error al descifrar: ¿contraseña incorrecta?"

#: src/extensions/crypt_extension.vala:240
msgid "Note decrypted"
msgstr "Nota descifrada"

