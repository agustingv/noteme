msgid "Archives all notes and images into a tar.gz file"
msgstr "Archiva todas las notas e imágenes en un archivo tar.gz"

#: src/dialogs/backup_dialog.vala:68 src/dialogs/backup_dialog.vala:88
msgid "Restore Backup"
msgstr "Restaurar copia de seguridad"

#: src/dialogs/backup_dialog.vala:69
msgid ""
"Restoring a backup will overwrite current notes and images. The app must be "
"restarted afterwards."
msgstr ""
"Restaurar una copia de seguridad sobreescribirá las notas e imágenes "
"actuales. La aplicación debe reiniciarse después."

#: src/dialogs/backup_dialog.vala:73
msgid "Backup File"
msgstr "Archivo de copia de seguridad"

#: src/dialogs/backup_dialog.vala:74
msgid "No file selected"
msgstr "Ningún archivo seleccionado"

#: src/dialogs/backup_dialog.vala:77
msgid "Select backup file…"
msgstr "Seleccionar archivo de copia de seguridad…"

#: src/dialogs/backup_dialog.vala:85 src/dialogs/backup_dialog.vala:137
msgid "Restore"
msgstr "Restaurar"

#: src/dialogs/backup_dialog.vala:86
msgid "Overwrites current data with the selected backup"
msgstr "Sobreescribe los datos actuales con la copia de seguridad seleccionada"

#: src/dialogs/backup_dialog.vala:98
msgid "Select Backup File"
msgstr "Seleccionar archivo de copia de seguridad"

#: src/dialogs/backup_dialog.vala:101
msgid "Backup archives"
msgstr "Archivos de copia de seguridad"

#: src/dialogs/backup_dialog.vala:133
msgid "Restore Backup?"
msgstr "¿Restaurar copia de seguridad?"

#: src/dialogs/backup_dialog.vala:134
msgid ""
"This will overwrite all current notes and images. The application must be "
"restarted to apply the changes."
msgstr ""
"Esto sobreescribirá todas las notas e imágenes actuales. La aplicación debe "
"reiniciarse para aplicar los cambios."

#: src/dialogs/backup_dialog.vala:164
msgid "Restore failed"
msgstr "Error al restaurar"

#: src/dialogs/backup_dialog.vala:168 src/dialogs/backup_dialog.vala:173
msgid "Restore error"
msgstr "Error de restauración"

#: src/dialogs/backup_dialog.vala:182
msgid "Backup Restored"
msgstr "Copia de seguridad restaurada"

#: src/dialogs/backup_dialog.vala:183
msgid ""
"The backup has been restored. Please restart the application to apply the "
"changes."
msgstr ""
"La copia de seguridad ha sido restaurada. Por favor, reinicia la aplicación "
"para aplicar los cambios."

#: src/dialogs/backup_dialog.vala:185
msgid "Close"
msgstr "Cerrar"

#: src/dialogs/backup_dialog.vala:186
msgid "Restart Now"
msgstr "Reiniciar ahora"

#: src/dialogs/backup_dialog.vala:226
msgid "Backup created"
msgstr "Copia de seguridad creada"

#: src/dialogs/backup_dialog.vala:230
msgid "Backup failed"
msgstr "Error al crear la copia de seguridad"

#: src/dialogs/backup_dialog.vala:233 src/dialogs/backup_dialog.vala:238
msgid "Backup error"
msgstr "Error de copia de seguridad"

#: src/dialogs/backup_dialog.vala:256
msgid "OK"
msgstr "Aceptar"

