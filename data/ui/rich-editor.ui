<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>

  <template class="NoteMeRichEditor" parent="GtkBox">
    <property name="orientation">vertical</property>

    <!-- Formatting toolbar -->
    <child>
      <object class="GtkBox">
        <property name="margin-start">8</property>
        <property name="margin-end">8</property>
        <property name="margin-top">6</property>
        <property name="margin-bottom">6</property>

        <!-- Format buttons (left) -->
        <child>
          <object class="GtkBox">
            <property name="spacing">6</property>

            <!-- B / I / U group -->
            <child>
              <object class="GtkBox">
                <style><class name="linked"/></style>

                <child>
                  <object class="GtkToggleButton" id="bold_button">
                    <property name="label">B</property>
                    <property name="tooltip-text" translatable="yes">Bold (Ctrl+B)</property>
                    <signal name="toggled" handler="onBoldToggled"/>
                    <style><class name="flat"/></style>
                  </object>
                </child>

                <child>
                  <object class="GtkToggleButton" id="italic_button">
                    <property name="label">I</property>
                    <property name="tooltip-text" translatable="yes">Italic (Ctrl+I)</property>
                    <signal name="toggled" handler="onItalicToggled"/>
                    <style><class name="flat"/></style>
                  </object>
                </child>

                <child>
                  <object class="GtkToggleButton" id="underline_button">
                    <property name="label">U</property>
                    <property name="tooltip-text" translatable="yes">Underline (Ctrl+U)</property>
                    <signal name="toggled" handler="onUnderlineToggled"/>
                    <style><class name="flat"/></style>
                  </object>
                </child>

              </object>
            </child>

            <!-- Code + List + Heading group -->
            <child>
              <object class="GtkBox">
                <style><class name="linked"/></style>

                <child>
                  <object class="GtkToggleButton" id="code_button">
                    <property name="label">&lt;/&gt;</property>
                    <property name="tooltip-text" translatable="yes">Inline Code (Ctrl+`)</property>
                    <signal name="toggled" handler="onCodeToggled"/>
                    <style><class name="flat"/></style>
                  </object>
                </child>

                <child>
                  <object class="GtkToggleButton" id="list_button">
                    <property name="label">•≡</property>
                    <property name="tooltip-text" translatable="yes">Bullet List (Ctrl+Shift+L)</property>
                    <signal name="toggled" handler="onListToggled"/>
                    <style><class name="flat"/></style>
                  </object>
                </child>


              </object>
            </child>

          </object>
        </child>

        <!-- Spacer -->
        <child>
          <object class="GtkBox">
            <property name="hexpand">true</property>
          </object>
        </child>

        <!-- Extension widgets (populated by extensions at runtime) -->
        <child>
          <object class="GtkBox" id="extension_box">
            <property name="spacing">4</property>
          </object>
        </child>

        <!-- Export button (right) -->
        <child>
          <object class="GtkButton" id="export_button">
            <property name="icon-name">document-save-as-symbolic</property>
            <property name="tooltip-text" translatable="yes">Export to file</property>
            <signal name="clicked" handler="onExportClicked"/>
            <style><class name="flat"/></style>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="GtkSeparator"/>
    </child>

    <!-- Editor stack: normal editing view or locked placeholder -->
    <child>
      <object class="GtkStack" id="editor_stack">
        <property name="vexpand">true</property>
        <property name="transition-type">crossfade</property>

        <!-- Normal editing page -->
        <child>
          <object class="GtkStackPage">
            <property name="name">editor</property>
            <property name="child">
              <object class="GtkPaned" id="preview_pane">
                <property name="orientation">horizontal</property>
                <property name="shrink-start-child">false</property>
                <property name="shrink-end-child">true</property>
                <property name="resize-start-child">true</property>
                <property name="resize-end-child">true</property>

                <property name="start-child">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <child>
                      <object class="GtkTextView" id="text_view">
                        <property name="wrap-mode">word-char</property>
                        <property name="pixels-above-lines">4</property>
                        <property name="pixels-below-lines">4</property>
                        <property name="left-margin">16</property>
                        <property name="right-margin">16</property>
                        <property name="top-margin">12</property>
                        <property name="bottom-margin">12</property>
                      </object>
                    </child>
                  </object>
                </property>

              </object>
            </property>
          </object>
        </child>

        <!-- Locked page -->
        <child>
          <object class="GtkStackPage">
            <property name="name">locked</property>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="valign">center</property>
                <property name="halign">center</property>
                <property name="spacing">12</property>

                <child>
                  <object class="GtkImage">
                    <property name="icon-name">system-lock-screen-symbolic</property>
                    <property name="pixel-size">64</property>
                    <style><class name="dim-label"/></style>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">This note is encrypted</property>
                    <style><class name="title-2"/></style>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Click the lock icon in the toolbar to enter your password</property>
                    <style><class name="dim-label"/></style>
                  </object>
                </child>

              </object>
            </property>
          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="GtkSeparator"/>
    </child>

    <!-- Footer: cursor position -->
    <child>
      <object class="GtkBox">
        <property name="margin-start">8</property>
        <property name="margin-end">8</property>
        <property name="margin-top">3</property>
        <property name="margin-bottom">3</property>

        <child>
          <object class="GtkBox">
            <property name="hexpand">true</property>
          </object>
        </child>

        <!-- Extension widgets in the footer (populated at runtime) -->
        <child>
          <object class="GtkBox" id="footer_extension_box">
            <property name="spacing">8</property>
          </object>
        </child>

        <child>
          <object class="GtkLabel" id="position_label">
            <property name="label">Ln 1, Col 1</property>
            <style>
              <class name="dim-label"/>
              <class name="caption"/>
            </style>
          </object>
        </child>

      </object>
    </child>

  </template>
</interface>
