<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>

  <template class="NoteMeNoteRow" parent="GtkBox">
    <property name="orientation">horizontal</property>
    <property name="spacing">0</property>

    <!-- Left color accent strip -->
    <child>
      <object class="GtkDrawingArea" id="color_strip">
        <property name="width-request">4</property>
      </object>
    </child>

    <!-- Note content -->
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">4</property>
        <property name="hexpand">true</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="margin-top">8</property>
        <property name="margin-bottom">8</property>

        <child>
          <object class="GtkLabel" id="title_label">
            <property name="xalign">0</property>
            <property name="ellipsize">end</property>
            <style><class name="heading"/></style>
          </object>
        </child>

        <child>
          <object class="GtkLabel" id="preview_label">
            <property name="xalign">0</property>
            <property name="ellipsize">end</property>
            <style><class name="dim-label"/><class name="caption"/></style>
          </object>
        </child>

      </object>
    </child>

  </template>
</interface>
